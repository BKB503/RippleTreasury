<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RippleTreasury.Infrastructure\RippleTreasury.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Include="../web/src/**/*;../web/public/**/*;../web/index.html;../web/package*.json;../web/tsconfig*.json;../web/vite.config.*;../../scripts/build-frontend.mjs" />
    <UpToDateCheckOutput Include="../web/dist/index.html;$(OutDir)wwwroot/index.html" />
  </ItemGroup>

  <!-- Build once for F5/publish; Node is never needed by the running API. -->
  <Target Name="BuildTreasuryFrontend" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../scripts/build-frontend.mjs&quot;" />
    <ItemGroup>
      <_FrontendAsset Include="../web/dist/**/*" />
      <None Include="@(_FrontendAsset)" Link="wwwroot/%(_FrontendAsset.RecursiveDir)%(_FrontendAsset.Filename)%(_FrontendAsset.Extension)" TargetPath="wwwroot/%(_FrontendAsset.RecursiveDir)%(_FrontendAsset.Filename)%(_FrontendAsset.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
