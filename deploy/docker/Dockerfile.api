FROM node:22-bookworm-slim AS frontend-toolchain
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
COPY --from=frontend-toolchain /usr/local/ /usr/local/
WORKDIR /source
COPY . .
RUN dotnet publish src/RippleTreasury.Api/RippleTreasury.Api.csproj -c Release -o /app
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet","RippleTreasury.Api.dll"]
